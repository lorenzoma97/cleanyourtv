<?xml version="1.0" encoding="utf-8"?>
<!-- One pick: the series' backdrop, a dark fade at the bottom with its name, the service in a corner. The same card,
     with the "draw" part shown, is "Pesca altre cinque" and "Tutte le serie". -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="96dp"
    android:layout_weight="1"
    android:layout_marginEnd="14dp"
    android:background="@drawable/card_bg"
    android:foreground="@drawable/card_fg"
    android:clipToOutline="true"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/card_shade" />

    <TextView
        android:id="@+id/svc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:background="@drawable/badge"
        android:textAllCaps="true"
        android:textColor="#FFFFFFFF"
        android:textSize="8sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="7dp"
        android:textAllCaps="true"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="0.02"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/draw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/drawIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_die"
            android:tint="#FFE5A00D"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/drawText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:gravity="center"
            android:text="@string/draw_more"
            android:textColor="#FFE5A00D"
            android:textSize="13sp"
            android:fontFamily="@font/outfit_medium" />
    </LinearLayout>
</FrameLayout>
