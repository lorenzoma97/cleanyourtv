<?xml version="1.0" encoding="utf-8"?>
<!-- Dark on the left (text side) and at the bottom, clear on the right where the picture shows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#F2050505" android:centerColor="#99050505" android:endColor="#00050505" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#E6050505" android:centerColor="#00050505" android:endColor="#00050505" />
        </shape>
    </item>
</layer-list>
