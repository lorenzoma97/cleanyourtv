<?xml version="1.0" encoding="utf-8"?>
<!-- Focused: solid white. Selected genre: amber outline on a faint amber fill. Rest: faint glass with a hairline. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#2EE5A00D" />
            <stroke android:width="1.5dp" android:color="#FFE5A00D" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="#1AFFFFFF" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</selector>
