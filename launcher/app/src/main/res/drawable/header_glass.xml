<?xml version="1.0" encoding="utf-8"?>
<!-- Fork lorenzoma97: dark translucent "glass" behind the clock and the weather, with a hairline edge (Apple-like
     material; the TV cannot blur what is behind a view cheaply, so it is a tint that still reads over any picture). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="18dp" />
    <solid android:color="#6B0E0F14" />
    <stroke android:width="1dp" android:color="#1FFFFFFF" />
</shape>
