<?xml version="1.0" encoding="utf-8"?>
<!-- Fork lorenzoma97: Home at rest (IdleActivity). A still picture, the time, and tonight's five as cards. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <ImageView
        android:id="@+id/idleArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/idle_scrim"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|left"
        android:orientation="vertical"
        android:paddingStart="68dp"
        android:paddingEnd="48dp"
        android:paddingBottom="44dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFFFF"
            android:textSize="104sp"
            android:fontFamily="@font/outfit_extralight"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:format12Hour="@string/date_format_home"
            android:format24Hour="@string/date_format_home"
            android:textAllCaps="true"
            android:letterSpacing="0.14"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit_regular" />

        <TextView
            android:id="@+id/idleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="40dp"
            android:text="Scopri una nuova serie"
            android:textAllCaps="true"
            android:letterSpacing="0.14"
            android:textColor="#FFE5A00D"
            android:textSize="12sp"
            android:fontFamily="@font/outfit_medium"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/idleCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
