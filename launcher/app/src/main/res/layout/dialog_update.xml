<?xml version="1.0" encoding="utf-8"?>
<!-- Fork lorenzoma97: an update of Home and/or Casa is downloaded and verified (Casa's Updater). Installa hands it to the
     system installer, which asks once more; Più tardi (or Back) asks again in 12 hours. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:elevation="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="Aggiornamento pronto"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/outfit_medium"
        android:letterSpacing="-0.01" />

    <TextView
        android:id="@+id/updateBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#D9FFFFFF"
        android:textSize="15sp"
        android:lineSpacingExtra="3sp"
        android:fontFamily="@font/outfit" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnLater"
            style="@style/TopButton"
            android:text="Più tardi"
            android:nextFocusUp="@+id/btnLater"
            android:nextFocusDown="@+id/btnLater"
            android:nextFocusLeft="@+id/btnLater"
            android:nextFocusRight="@+id/btnInstall" />

        <TextView
            android:id="@+id/btnInstall"
            style="@style/TopButton"
            android:text="Installa"
            android:nextFocusUp="@+id/btnInstall"
            android:nextFocusDown="@+id/btnInstall"
            android:nextFocusLeft="@+id/btnLater"
            android:nextFocusRight="@+id/btnInstall" />
    </LinearLayout>
</LinearLayout>
